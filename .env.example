# Smart Parking MVP
# VITE_* variables are bundled into browser code and are NOT secrets.
# For this MVP, keep the key out of GitHub by configuring it only in Vercel.
# This remains client-side encryption by design; the browser can access the key.

VITE_PARKING_QR_KEY=set-this-only-in-vercel
VITE_LEMON_SQUEEZY_PARKING_CHECKOUT_URL=https://YOUR-STORE.lemonsqueezy.com/checkout/buy/YOUR-VARIANT-ID
VITE_RAZORPAY_PARKING_PAYMENT_LINK=https://rzp.io/l/YOUR-PAYMENT-LINK

# Endpoint used by the purchased Smart Parking Sticker activation form.
# Configure this with a form/email service endpoint that accepts JSON POST requests.
VITE_PARKING_REQUEST_FORM_ENDPOINT=https://formsubmit.co/ajax/richlifetools.support@gmail.com
