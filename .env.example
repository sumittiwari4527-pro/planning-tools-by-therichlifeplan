# VITE_* variables are public browser config, never secrets.
VITE_PARKING_QR_KEY=set-this-only-in-vercel
VITE_LEMON_SQUEEZY_PARKING_CHECKOUT_URL=https://YOUR-STORE.lemonsqueezy.com/checkout/buy/YOUR-VARIANT-ID
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PUBLIC_SITE_URL=https://www.richlifetools.com
VITE_META_PIXEL_ID=your_meta_pixel_id
VITE_PARKING_REQUEST_FORM_ENDPOINT=https://formsubmit.co/ajax/richlifetools.support@gmail.com

# MoneyFlow server-side download settings. Do not prefix these with VITE_.
# Upload the workbook and PDF to PRIVATE object storage. Do not place either file in /public or this public GitHub repository.
MONEYFLOW_DOWNLOAD_SECRET=replace-with-at-least-32-random-characters
MONEYFLOW_WORKBOOK_PRIVATE_URL=https://PRIVATE-STORAGE-URL/workbook.xlsx
MONEYFLOW_GUIDE_PRIVATE_URL=https://PRIVATE-STORAGE-URL/quick-start.pdf
MONEYFLOW_ASSET_STORAGE_TOKEN=optional-private-storage-bearer-token
